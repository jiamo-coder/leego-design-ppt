{
  "schemaVersion": "2.0",
  "title": "跨平台演示验证",
  "language": "zh-CN",
  "audience": "安装使用者",
  "purpose": "验证可编辑输出与素材完整性",
  "brand": {
    "name": "Leego 示例"
  },
  "theme": "purple-tech",
  "style": {
    "fontFace": "Source Han Sans SC"
  },
  "slides": [
    {
      "id": "cover",
      "narrativeJob": "说明样例性质",
      "layout": "cover",
      "title": "同一套规范，跨平台生成",
      "body": "以下均为合成示例，用于验证文字、图片和数据的输出。"
    },
    {
      "id": "contain",
      "narrativeJob": "完整呈现竖幅图片",
      "layout": "split-visual",
      "title": "竖幅证据保留完整边界",
      "visuals": [
        {
          "src": "portrait.png",
          "alt": "合成紫框测试图",
          "fit": "contain",
          "caption": "完整边框必须全部可见"
        }
      ],
      "items": [
        {
          "title": "先保全貌",
          "body": "图片保持比例；避免为了填满区域裁去关键信息。"
        }
      ]
    },
    {
      "id": "crop",
      "narrativeJob": "核验焦点裁切",
