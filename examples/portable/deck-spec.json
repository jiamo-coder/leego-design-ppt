      "title": "全貌与局部并列说明",
      "visuals": [
        {
          "src": "portrait.png",
          "alt": "完整合成图",
          "fit": "contain",
          "caption": "全貌"
        },
        {
          "src": "portrait.png",
          "alt": "中心焦点合成图",
          "fit": "cover",
          "focalPoint": {
            "x": 0.5,
            "y": 0.5
          },
          "caption": "明确标注的细节裁切"
        }
      ]
