{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jiamo-coder/leego-design-ppt/main/skill/leego-design-ppt/assets/deck-spec.schema.json",
  "title": "Leego Design PPT deck specification",
  "type": "object",
  "required": ["schemaVersion", "title", "language", "audience", "purpose", "brand", "theme", "slides"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "title": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "audience": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "centralTakeaway": { "type": "string" },
    "brand": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "englishName": { "type": "string" },
        "logo": { "type": "string" }
      },
      "additionalProperties": true
    },
    "theme": { "type": "string", "minLength": 1 },
    "bannedTerms": { "type": "array", "items": { "type": "string" } },
    "replacements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": { "from": { "type": "string" }, "to": { "type": "string" } }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "narrativeJob", "layout", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "narrativeJob": { "type": "string" },
          "layout": { "type": "string" },
          "title": { "type": "string" },
          "eyebrow": { "type": "string" },
          "body": { "type": "string" },
          "items": { "type": "array", "items": { "type": "object" } },
          "visuals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["src", "fit"],
              "properties": {
                "src": { "type": "string" },
                "alt": { "type": "string" },
                "fit": { "enum": ["contain", "cover"] },
                "focalPoint": {
                  "type": "object",
                  "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 } }
                },
                "transparentRequired": { "type": "boolean" },
                "minimumWidth": { "type": "integer", "minimum": 1 },
                "minimumHeight": { "type": "integer", "minimum": 1 },
                "license": { "type": "string" }
              }
            }
          },
          "sources": { "type": "array", "items": { "type": "string" } },
          "notes": {
            "type": "object",
            "properties": {
              "purpose": { "type": "string" },
              "talkingPoints": { "type": "array", "items": { "type": "string" } },
              "transition": { "type": "string" }
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
